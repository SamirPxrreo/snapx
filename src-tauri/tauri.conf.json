{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapX",
  "version": "0.1.0",
  "identifier": "com.snapx.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SnapX",
        "width": 620,
        "height": 470,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SnapX",
    "copyright": "",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
