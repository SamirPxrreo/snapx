{
  "name": "snapx",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "SnapX - captura y anotacion de pantalla estilo CleanShot para Windows",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ui": "vite --config vite.mock.config.ts",
    "tauri": "tauri",
    "icon": "node scripts/make-icon.js && npx tauri icon assets/icon-512.png -o src-tauri/icons"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
